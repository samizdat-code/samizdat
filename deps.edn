{;; jolt.ffi/write takes the value BEFORE the offset as of jolt 0.8.0, and the
 ;; two spellings are both integers — an older runtime writes to the wrong
 ;; place rather than failing. Declare the floor so it refuses instead.
 ;; 0.8.13: a fiber may park inside a lazy seq's realization (mapv over two
 ;; collections, filterv, for, doall over map) — before it, a store call
 ;; there raised whenever another fiber held the connection lock, which is
 ;; what killed run ab935047 — and a caught exception carries its stack,
 ;; which a failed run's record hands the agent (jolt-lang/jolt#1142).
 ;; 0.8.16: Constructor.newInstance spreads its Object[] and getConstructors /
 ;; getParameterTypes return arrays, so SCI calls a constructor that takes
 ;; arguments — `delay`, `(Exception. msg)`, `case`'s no-match throw — in the
 ;; cell sandbox (karamazov-jfcf).
 ;; 0.8.22: :reload-all reloads each namespace once, in its own namespace
 ;; (karamazov-cc3a), so the live-image idiom below works; a process that
 ;; cannot create its AOT cache runs without one instead of dying, which a
 ;; sandboxed image needs (jolt-lang/jolt#1335); and a set or map literal
 ;; whose computed keys collide throws, as on the JVM.
 :jolt/min-version "0.8.22"

 :paths ["src" "resources"]

 ;; Git deps are fetched into ~/.jolt/gitlibs by jolt. Full SHAs only —
 ;; `git fetch` can't resolve short ones.
 :deps {;; provider calls (clj-http-lite over jolt.ffi sockets + OpenSSL + libz)
        ;; :conn-timeout is honoured from v0.0.3 on: the connect itself is
        ;; bounded through a non-blocking socket, which needs jolt 0.6.8's
        ;; :varargs FFI marker (fcntl is variadic, and on Apple arm64 a
        ;; fixed-arity binding silently corrupts the stack-passed argument).
        ;; v0.0.8: reads are interruptible (poll in 250 ms slices, the
        ;; interrupt flag checked between them), so a cancelled provider call
        ;; returns within a slice rather than after the socket timeout
        ;; (RFC-013, karamazov-3cll.10). v0.1.0 needs jolt 0.8.16, the floor
        ;; above already. v0.1.3: `:as :stream` returns at the headers and
        ;; reads the body as it arrives (karamazov-vosh), so a provider can
        ;; bound the gap between chunks rather than the whole response.
        jolt-lang/http-client
        {:git/url "https://github.com/jolt-lang/http-client"
         :git/tag "v0.1.3"
         :git/sha "7ea9bbd3b176b4567b4c94d7177d67c5f06109f7"}

        ;; the HTTP server: HTTP/1.1 over BSD sockets through jolt.ffi, with a
        ;; worker pool (a long request no longer holds /health) and channel
        ;; bodies streamed chunked, which is what ring-chez.sse needs for the
        ;; event stream the front ends follow. Was vendored at @07f14d9.
        ;; v0.7.8: the listening socket and accepted connections are
        ;; close-on-exec (a child process no longer keeps the port bound),
        ;; and :port 0 picks a free port.
        jolt-lang/ring-chez-adapter
        {:git/url "https://github.com/jolt-lang/ring-chez-adapter"
         :git/tag "v0.7.11"
         :git/sha "b2b209dd59ab824e52b61ed3c5cc5fee85346989"}

        ;; the HTTP server's routing: a table of route maps, best-match (a
        ;; literal segment beats a parameter), no dependencies of its own.
        askonomm/ruuter
        {:git/url "https://git.nmm.ee/asko/ruuter.git"
         :git/tag "v2.1.1"
         :git/sha "263f868cf19e73ccda7cda6b4d4af1d8fe504749"}

        ;; durable sessions: jdbc.core over the system libsqlite3 via jolt.ffi
        jolt-lang/db
        {:git/url "https://github.com/jolt-lang/db"
         :git/tag "v0.4.1"
         :git/sha "067f95e23ea8e1117052762e97d63436d2c6c259"}

        ;; nREPL middleware (sessions, interruptible eval, completion, lookup) so
        ;; an editor can drive the running harness. See core/start-nrepl!. The
        ;; project image runs this same sha (repl/image.clj nrepl-sha, held
        ;; equal by base-test). v0.1.2: the client transport's recv is
        ;; interruptible, so a cancelled image eval frees its reader within a
        ;; slice (RFC-013, karamazov-3cll.10).
        jolt-lang/nrepl
        {:git/url "https://github.com/jolt-lang/nrepl"
         :git/tag "v0.2.1"
         :git/sha "aad8baef0dfe56d288792017841f37321d8160b1"}

        ;; OpenSSL/SecureRandom shims. http-client pulls this in too; jolt.deps
        ;; reconciles the duplicate libssl/libcrypto natives to a single load.
        jolt-lang/jolt-crypto
        {:git/url "https://github.com/jolt-lang/jolt-crypto"
         :git/tag "v0.0.11"
         :git/sha "0f9c50b80e227c1aa045f47e88a0f4d150d6e70b"}

        ;; statistics: Beta and Gamma posteriors with forgetting, layered
        ;; priors, a forecast ledger, calibration, scoring — the core of
        ;; bayesian-news-model taken out, no dependencies of its own. The
        ;; arena's reliability statistics read it (karamazov-gvdk).
        io.github.jlt-commons/augur
        {:git/url "https://github.com/jlt-commons/augur"
         :git/tag "v0.4.1"
         :git/sha "dcdaad70c26f12ec1681eb4eee98463de15be0a3"}

         org.clojure/data.json
         {:git/url "https://github.com/clojure/data.json"
          :git/sha "94463ffb54482427fd9b31f264b06bff6dcfd557"}

         ;; instaparse (EPL), for the shell policy's lexer: a POSIX-subset
         ;; grammar in place of a hand-rolled quote-aware scanner
         ;; (karamazov-41a.5). The jolt port — .cljc sources, no deps of its
         ;; own; needs jolt past 0.6.8 (jolt-lang/jolt#567), which the
         ;; :jolt/min-version above already requires.
         jolt-lang/instaparse
         {:git/url "https://github.com/jolt-lang/instaparse"
          :git/sha "111fae05f30ea0c4f6b13945d9505901649abc6d"}

         ;; Selmer renders every prompt template ({{...}} placeholders). Its
         ;; java.time FormatStyle use needs jolt-lang/time (below); prompts
         ;; carry code, so escaping is off (samizdat.prompt).
         selmer/selmer {:mvn/version "1.13.5"}

        ;; src/mycelium — schema contracts and validation. malli.generator
        ;; hard-requires test.check at namespace load, and mycelium.dev loads
        ;; malli.generator, so test.check rides along in the main deps.
        metosin/malli {:mvn/version "0.20.2"}
        org.clojure/test.check {:mvn/version "1.1.3"}

        ;; src/mycelium/patch — a checked manifest edit writes back over the
        ;; ORIGINAL text so the stored body keeps its comments (the manifests
        ;; are half prose about why an edge is where it is). rewrite-clj is
        ;; the node tree that makes a minimal rewrite possible; upstream
        ;; mycelium pins the same version. Loads under jolt unmodified.
        rewrite-clj/rewrite-clj {:mvn/version "1.3.59"}

        ;; src/samizdat/symbolic — the rule layer's substrate (RFC/karamazov-41a).
        ;; Runs unmodified: 423 tests, 658 assertions, 0 failures under jolt.
        ;; No fork and no jolt port — the Maven artifact ships the .clj sources
        ;; jolt compiles, and the pom's only non-provided dep is clojure itself
        ;; (clojurescript is <scope>provided</scope>, so it does not ride along).
        ;; Requiring core.logic + fd + pldb + unifier costs ~40ms of boot.
        org.clojure/core.logic {:mvn/version "1.1.1"}

        ;; ebb — missionary ported to jolt: cancellable tasks (sp, via blk,
        ;; timeout, join) and flows (observe, relieve). The concurrency
        ;; substrate RFC-013 specifies; adopted under karamazov-3cll. Pure
        ;; Clojure, no deps of its own; requiring ebb.core costs ~60ms of
        ;; boot (measured 2026-09-06, warm cache). The checkout at
        ;; ~/src/jlt-commons/ebb is ours to change; pin a full sha here.
        ;; v0.1.3 carries the fix for a cancelled ap spinning forever
        ;; (ebb PR #7, found by the supervisor stream here); v0.1.4 builds
        ;; timer deadlines on jolt 0.8.21's monotonic clock, without which
        ;; sleep and timeout never fire and no eval budget holds.
        jlt-commons/ebb
        {:git/url "https://github.com/jlt-commons/ebb"
         :git/tag "v0.1.4"
         :git/sha "15f6f7c0ee8b54a862e9f981b5867fab23459498"}

        ;; SCI: cells and the policy tables' :when forms are evaluated in an
        ;; SCI context that sees only the allowlist in samizdat.sandbox.sci,
        ;; not in the harness compiler (karamazov-3vu1.9). Loading all the
        ;; shipped cells costs about the same as load-string did.
        yogthos/sci
        {:git/url "https://github.com/yogthos/sci.git"
         :git/sha "1295142fc29f206dd2747963548ba038077d9205"}

        ;; clojure.tools.logging ported to jolt (stderr backend, :info+ default)
        org.clojure/tools.logging
        {:git/url "https://github.com/jolt-lang/logging"
         :git/sha "ec6747e55583118d881faf4ab41e68d7e587ce4c"}

        ;; java.time host shim. tools.logging formats timestamps with
        ;; DateTimeFormatter, which core does not provide (RFC 0008), so
        ;; logging anything without this dep throws at the first log call.
        ;; bc85090 brings DateTimeFormatterBuilder.appendFraction (PR #7/#8),
        ;; which malli.transform's date formatter needs at namespace load.
        jolt-lang/time
        {:git/url "https://github.com/jolt-lang/time"
         :git/tag "v0.0.11"
         :git/sha "2c58d9c709a25d80608757c3026f4c656a994ef1"}}

 ;; The HTTP server (ring-chez-adapter) binds BSD sockets through the running
 ;; process's own libc symbols, so they must be loaded before it is required.
 :jolt/native [{:name "libc (POSIX sockets)" :process true}]

 ;; Bake resources/ into the binary, so io/resource resolves with no files on
 ;; disk and a built harness runs from any cwd.
 ;;
 ;; `jolt build` links code and deps, not data: without this the binary
 ;; resolved gates.edn, phases.edn, wordlists.edn, prompts/, manifests/ and
 ;; cells/ RELATIVE TO THE WORKING DIRECTORY, so it booted from the project
 ;; root and died anywhere else with "Cannot open <nil> as a Reader" — a
 ;; nil resource handed to slurp, from the first reload-config! in
 ;; system/start!. Every "works interpreted and inside an AOT binary" comment
 ;; on an io/resource seam in src was true only by accident of cwd.
 :jolt/build {:embed ["resources"]}

 :nrepl/middleware [nrepl.middleware/default-middleware]

 ;; "tui" and "acp" are SOURCE paths here, not their toolkits: no toolkit
 ;; deps ride along on the test path. Everything except the TUI's own run loop
 ;; is toolkit-free — its widgets return hiccup, which is data — so the suite
 ;; covers them without cmake or a terminal.
 :aliases {:test {:extra-paths ["test" "tui" "acp"]
                  :main-opts ["-m" "samizdat.test-runner"]}
           ;; The dev tree (the nREPL client, the ebb spike) plus the tests, so
           ;; a live image can run the suite without paying startup — with
           ;; :test too: `jolt -A:dev:test nrepl-server 7899`, then
           ;; (require 'samizdat.test-runner :reload-all)
           ;; (samizdat.test-runner/run). See AGENTS.md, "Live development
           ;; over nREPL".
           :dev  {:extra-paths ["dev" "test"]}

           ;; The TUI has its own source root and toolkit dep, and is a strict
           ;; HTTP client of the server. `jolt serve` and `jolt -M:test` never
           ;; load its native toolkit.
           ;;
           ;; ftxui-jolt carries a C++ shim that has to be COMPILED (cmake
           ;; and a C++17 compiler), and jolt runs no prep step for a git dep:
           ;; the tag resolves into ~/.jolt/gitlibs as sources only and would
           ;; fail at the first FFI call. `jolt tui-native` builds it there,
           ;; once per pinned sha, and the tasks that load the TUI run it
           ;; first. Bump :git/tag and :git/sha together, in both aliases.
           ;; The ACP agent (karamazov-05z0.17): an editor runs `jolt acp`
           ;; as a subprocess and speaks the Agent Client Protocol to it. A
           ;; strict HTTP client of a running server, like the TUI, and with
           ;; no toolkit, so its source is on the test path too.
           :acp  {:extra-paths ["acp"]
                  :main-opts ["-m" "samizdat.acp.main"]}
           :tui  {:extra-paths ["tui"]
                  :extra-deps
                  {jlt-commons/ftxui-jolt
                   {:git/url "https://github.com/jlt-commons/ftxui-jolt"
                    :git/tag "v0.5.0"
                    :git/sha "219e063955b8475a427eca6e98dcf9263b1f0fd5"}}
                  ;; samizdat.main: the server and the TUI in one process;
                  ;; --headless for the server alone, --connect URL for the
                  ;; TUI alone against a running server.
                  :main-opts ["-m" "samizdat.main"]}

           ;; The half of the TUI the main suite cannot cover: what the
           ;; TOOLKIT does with the hiccup — that a click on a fold's header
           ;; actually opens it. It drives real FTXUI widgets headlessly, so
           ;; it needs no terminal, but it does need the compiled shim, which
           ;; is why it is its own alias rather than part of `jolt test`.
           ;;
           ;;     jolt tui-test
           :tui-test {:extra-paths ["tui" "test-tui"]
                      :extra-deps
                      {jlt-commons/ftxui-jolt
                       {:git/url "https://github.com/jlt-commons/ftxui-jolt"
                        :git/tag "v0.5.0"
                        :git/sha "219e063955b8475a427eca6e98dcf9263b1f0fd5"}}
                      :main-opts ["-m" "samizdat.tui.test-runner"]}}

 :tasks {serve {:doc "start the harness (HTTP + nREPL) and park"
                :main-opts ["-m" "samizdat.core"]}
         ;; A shell-string task, because a :tasks :main-opts entry cannot carry
         ;; an -A alias — main-opts are only ever main-opts.
         dev   "jolt -A:dev -m samizdat.core"
         smoke {:doc "Phase 0 platform probes: z3, swipl, sqlite, https, server"
                :main-opts ["-m" "samizdat.smoke"]}
          ;; The ulimit raise on `test` is load-bearing: the suite holds ~260
          ;; fds at peak and the default 256 soft limit made the last five
          ;; namespaces error spuriously (socket() failed / sqlite open failed
          ;; {:rc 14}) — provenance A-3. `;` not `&&` so a hardened
          ;; environment where 1024 exceeds the hard limit still runs.
          test  "(ulimit -n 1024 2>/dev/null; jolt -M:test)"
         ;; The whole application: the server and the TUI in one process.
         ;; `jolt tui --connect [URL]` attaches to a server already running.
         tui   "jolt tui-native && jolt -M:tui"
         ;; Build the pinned ftxui-jolt's shim in its gitlibs checkout — found
         ;; through the classpath, so it follows the pin — unless it is built
         ;; already (ftxui-jolt's own `native` task checks).
         ;; Under sh -c because jolt runs a task string's own `jolt ...`
         ;; steps in-process, where a `cd` before them does not apply.
         tui-native "sh -c 'd=$(jolt -Spath -A:tui | tr : \"\\n\" | grep ftxui-jolt | head -1) && test -n \"$d\" && cd \"${d%/src}\" && jolt native'"
         ;; The binary, from the same entry point. -A:tui because the TUI's
         ;; toolkit lives only under that alias. `jolt build` itself is
         ;; always the compiler, so the task cannot take that name.
         bin   "jolt tui-native && jolt -A:tui build -m samizdat.main -o samizdat"
         ;; A shell string, not :main-opts: a task's main-opts cannot carry an
         ;; -M alias, and this one needs the ftxui dep.
         tui-test "jolt tui-native && jolt -M:tui-test"
         ;; samizdat as an ACP agent on stdio, against a running server.
         acp "jolt -M:acp"
         ;; Policy trace files: tool calls and the decision each should get,
         ;; replayed against the real decisions with nothing run
         ;; (samizdat.security.replay). test/policy by default.
         policy-test {:doc "replay policy trace files: jolt policy-test [file-or-dir ...]"
                      :main-opts ["-m" "samizdat.security.replay"]}
         export {:doc "runs that shipped and verified, as JSONL trajectories — or with --verdicts, every judgement labelled by its outcome: jolt export <db> [out.jsonl] [--verdicts]"
                 :main-opts ["-m" "samizdat.export"]}}}
