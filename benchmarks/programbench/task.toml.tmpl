schema_version = "1.1"
artifacts = []

[task]
name = "programbench-jolt/{name}"
description = "Rebuild {repo} in Clojure on Jolt from its binary and documentation."

[metadata]
source = "ProgramBench {iid}"
language = "{language}"
difficulty = "{difficulty}"

[verifier]
timeout_sec = 3600.0

[agent]
timeout_sec = {limit}

[environment]
build_timeout_sec = 1200.0
cpus = 2
memory_mb = 4096
storage_mb = 10240
